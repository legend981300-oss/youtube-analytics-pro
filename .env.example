# ==============================================================================
# YOUTUBE ANALYTICS PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local to configure optional external services:
#   cp .env.example .env.local
#
# NOTE: All external API keys are 100% decoupled and optional.
# The application operates fully out-of-the-box with high-fidelity local deterministic
# telemetry simulation if no API keys are provided.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Base canonical URL for OAuth callbacks, webhooks, and absolute routing
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AI CREATIVE STUDIO (Decoupled: Gemini 1.5 Flash or OpenAI GPT-4o-mini)
# ------------------------------------------------------------------------------
# [Option A - Recommended & Free Tier] Google Gemini API Key
# Used for high-CTR title generation, SEO descriptions, and script outlines.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# [Option B - Alternative] OpenAI API Key
# Fallback provider if you prefer OpenAI models (e.g., gpt-4o-mini).
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD DATABASE & AUTHENTICATION (Optional)
# ------------------------------------------------------------------------------
# Used for multi-device user persistence, video ideas vault sync, and goal tracking.
# If omitted, state automatically persists in local browser storage (Offline-First).
# Create a free PostgreSQL project at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ------------------------------------------------------------------------------
# 4. GOOGLE / YOUTUBE OAUTH 2.0 & DATA API V3 (Optional)
# ------------------------------------------------------------------------------
# Setup Google Cloud Console OAuth 2.0 Client credentials:
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Enable "YouTube Data API v3" and "YouTube Analytics API"
# 3. Add Authorized Redirect URI: http://localhost:3000/api/auth/youtube/callback
#    (For production, add: https://your-domain.vercel.app/api/auth/youtube/callback)
NEXT_PUBLIC_YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Google YouTube Data API v3 Key (Public search & video lookups)
YOUTUBE_API_KEY=AIzaSy-your-youtube-data-api-key

# ------------------------------------------------------------------------------
# 5. STRIPE / LEMON SQUEEZY MONETIZATION (Optional & 100% Decoupled)
# ------------------------------------------------------------------------------
# Connect your live payment links to automatically route creators to checkout:
# Create a Payment Link at: https://dashboard.stripe.com/payment-links
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/your-pro-link
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_STUDIO=https://buy.stripe.com/your-studio-link

# Alternative: Lemon Squeezy checkout URLs:
# NEXT_PUBLIC_LEMON_SQUEEZY_URL_PRO=https://yourstore.lemonsqueezy.com/checkout/buy/...
# NEXT_PUBLIC_LEMON_SQUEEZY_URL_STUDIO=https://yourstore.lemonsqueezy.com/checkout/buy/...

# Stripe Customer Billing Portal URL (for managing active subscriptions & invoices)
# https://dashboard.stripe.com/settings/billing/portal
NEXT_PUBLIC_BILLING_PORTAL_URL=https://billing.stripe.com/p/session/test

